node_modules/
.env
.env.backup-*
logs/
*.log

# Database dumps. These carry real customer data (names, phone numbers,
# balances) and run to tens of megabytes — they belong on disk, not in git.
*.dump
*.sql
!db/migrations/*.sql

# Scratch output from `drizzle-kit introspect`. Regenerable, never imported.
.drizzle-introspect/
AUDIT.md
PACKAGES.md
CUSTOMER_PORTAL_PLAN.md
SCHEMA_PLAN.md
Soroman_Auth_Comparison.pdf
API_TESTING.md
HARDENING_PLAN.md
WHATSAPP_PLAN.md
WHATSAPP_ENGINE_PLAN.md
PR2_PLAN.md
.claude/

# Pre-repair table snapshots: production customer data, never committed.
scripts/backups/

# Local previews from scripts/send-daily-report.js --dry and send-pfi-report.js
pfi-report-*.html
daily-report-*.html

# Rollback snapshots written beside the repair script that took them. Same
# reason as scripts/backups/ above: production rows, including staff names.
scripts/rollback-*.json
