# =============================================================================
# Soroman Dashboard Server — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/soroman_dashboard?sslmode=verify-full

# Isolated database for `npm test`. The suites insert real fixture rows and do
# not clean up, so they must never run against DATABASE_URL. Create a SEPARATE
# database (e.g. a second database in the same Neon project, `soroman_test`) and
# point this at it, then migrate it once:
#   DATABASE_URL="$TEST_DATABASE_URL" npm run db:migrate
# When set, `npm test` uses it automatically. If unset, tests refuse to run
# against a remote DATABASE_URL (a localhost/CI database is always allowed);
# set ALLOW_TESTS_ON_DEV_DB=true only for a deliberate one-off.
# TEST_DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/soroman_test?sslmode=verify-full

# Access-token signing secrets, one per realm.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# They MUST differ. A shared secret means a customer token verifies as a staff
# token anywhere an audience check is missed. Boot fails if they match.
#
# Both names are explicit — ACCESS_TOKEN_SECRET is the OLD name and is no
# longer read at all. Rename it in your .env or the server will refuse to boot.
#
# CUSTOMER_ACCESS_TOKEN_SECRET is REQUIRED in production; outside production
# one is derived from the staff secret, with a warning.
STAFF_ACCESS_TOKEN_SECRET=your_staff_access_token_secret_here
CUSTOMER_ACCESS_TOKEN_SECRET=your_customer_access_token_secret_here


# REFRESH_TOKEN_SECRET is no longer used. Refresh tokens are opaque random
# strings stored as salted-domain SHA-256 hashes, so there is nothing to sign.

# Refresh-cookie SameSite policy. "strict" blocks the cross-site POST that CSRF
# depends on and is correct when the portal shares a registrable domain with
# the API. A portal on a genuinely different domain needs "none", which
# requires HTTPS — the CSRF double-submit then becomes the primary defence.
#
# IMPORTANT — cross-site production: when the portal and API sit on different
# registrable domains (e.g. a Railway frontend + a Render API), "strict"/"lax"
# means the browser never returns the refresh cookie on the cross-site request,
# so sign-in appears to work but the session silently dies on the next reload.
# There is no error and CORS still passes — the only fix is COOKIE_SAMESITE=none
# (which forces Secure on automatically). Co-locate both under one parent domain
# instead (app.example.com + api.example.com) to keep this "strict".
COOKIE_SAMESITE=strict

# Phone handling. Bare local numbers (08012345678) are resolved against this
# country; international customers must supply a country code.
DEFAULT_PHONE_COUNTRY=NG

# Comma-separated ISO country codes permitted to receive an OTP.
# Unset (or blank) means every country is allowed. Set this to the markets you
# actually serve before launch — unrestricted international OTP is the classic
# SMS-pumping / toll-fraud surface.
# OTP_ALLOWED_COUNTRIES=NG,GH

# Hard daily ceiling on OTP sends. Turnstile reduces volume; only this bounds
# it, and unlike a captcha it also covers retry loops and bad deploys.
OTP_DAILY_SEND_CAP=500

# Cloudflare Turnstile. Optional in development (the check is skipped when
# unset) so the backend can ship before the frontend renders the widget.
# REQUIRED in production — the server refuses to boot without it.
# TURNSTILE_SECRET_KEY=

# OTP rate limits. Per-phone is the precise control. Per-IP is a loose backstop
# on purpose: Nigerian carriers use CGNAT, so many customers share one address.
# OTP_REGISTER_PER_PHONE=2
# OTP_REGISTER_PER_IP=30
# OTP_LOGIN_PER_PHONE=3
# OTP_LOGIN_PER_IP=60

# Development-only OTP bypass: a fixed code and no SMS dispatch. Verification
# still runs in full. Both must be set. The server refuses to boot with this on
# in production or alongside a live Paystack key. Never ship these.
# OTP_DEV_MODE=true
# OTP_DEV_CODE=000000

# Store-review demo account: a static OTP for designated numbers only. Allowed
# in production (App Store / Play reviewers cannot receive SMS). Both must be
# set; an empty allowlist is fail-closed. Comma-separated phones, any common
# format — they are normalised to E.164. Unset both after review is approved.
# OTP_DEMO_PHONES=+2348012345678
# OTP_DEMO_CODE=000000

# Server
PORT=5002

# REQUIRED. Must be one of: production | staging | development | test.
# The error handler decides whether to expose stack traces from this, so an
# unset or misspelled value is fatal at boot rather than silently permissive —
# "prodcution" would otherwise read as non-production and leak internals.
NODE_ENV=development

# CORS — comma-separated exact origins (scheme + host, no trailing slash).
# Merged with the localhost defaults in config/allowedOrigins.js. In production
# add the deployed portal origin, e.g.
#   CORS_ALLOWED_ORIGINS=https://soroman-frontend.up.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Email (Resend) — required for password setup emails.
# NOTE: the Django backend's "SMTP" config is this same Resend account via its
# SMTP gateway (smtp.resend.com, user `resend`, password = the API key below),
# so both backends send from one verified domain. Do not switch providers while
# keeping the From address — that is what breaks SPF/DKIM.
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Soroman Energy <orders@soromannl.com>
CLIENT_URL=http://localhost:3000

# Cloudinary — required for file uploads (licenses, documents, etc.)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paystack — required for virtual account generation
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# When an unpaid order lapses (marked Expired, reserved stock returned).
#
# The rule is END OF DAY, not a rolling window: everything still unpaid expires
# at this wall-clock time on the day it was placed, so each trading day opens
# with the depot's real stock position. An order placed at 23:50 therefore has
# ten minutes -- that is deliberate, see config/orderExpiry.js.
#
# HH:MM, defaults to 23:59. The nightly cron expression is DERIVED from this,
# so changing it moves the deadline and the sweep together.
ORDER_EXPIRY_AT=23:59

# The zone that time is read in. Falls back to REPORT_TIMEZONE, then Africa/Lagos.
# ORDER_EXPIRY_TZ=Africa/Lagos

# Set to "true" to switch the whole expiry mechanism off -- the sweep, the lazy
# per-request check, and the deadline shown to customers. A business call, not
# a config tune.
# ORDER_EXPIRY_DISABLED=false

# Set to "true" to run recurring jobs (the order-expiry sweep) in-process on a
# cron. Off by default; the manual POST /api/order-expiry/run endpoint works
# either way. ORDER_EXPIRY_CRON overrides the derived schedule -- only set it if
# you need a backstop sweep at another hour, and note it does NOT move the
# deadline itself (ORDER_EXPIRY_AT does).
SCHEDULED_JOBS_ENABLED=false
# ORDER_EXPIRY_CRON=59 23 * * *

# Termii — required for SMS notifications (and customer login OTP).
# v3 API, key travels in the JSON body (no bearer header). The sender ID is max
# 11 chars and must be APPROVED per-account by Termii before it will send.
# Numbers are normalised to 234XXXXXXXXXX by utils/phone.js — no +, no leading 0.
TERMII_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
TERMII_SENDER_ID=Soroman

# Where "a PFI has been raised and needs reviewing" is sent.
#
# One number, not a role: the review desk is one person's job, and deriving it
# from a role would page every super_admin for every batch. Leaving it unset is
# a valid state — the PFI is still raised and still waits, nobody is just told
# about it by SMS. It never blocks a save.
PFI_REVIEW_PHONE=
TERMII_BASE_URL=https://v3.api.termii.com

# Termii routing. Two routes, and they are not interchangeable:
#   generic   promotional. Skips numbers on Nigeria's DND register (roughly a
#             third of them) and is blocked 8PM-8AM WAT on MTN.
#   dnd       transactional. The only route that reaches a DND-registered
#             handset, and reserved for messages the customer's action asked
#             for. Everything but the `marketing` category goes here first.
#
# TERMII_SENDER_ID above is the ONLY sender ID — every route, every message,
# OTPs included. Termii approves a sender ID per route, so if the branded ID is
# not whitelisted for dnd, that leg is accepted ("Successfully Sent") and then
# rejected by the carrier, and the generic leg runs behind it. Watch the
# delivery log after a deploy: a run of `sender_id` or `rejected` reasons on
# the dnd channel means the whitelisting has not landed at Termii yet.
# Put PROMOTIONAL traffic on the dnd route too. Leave off. A DND registration
# is the customer's opt-out from marketing; routing promos around it is what
# gets a sender ID's DND approval revoked — and the OTPs share that approval.
# TERMII_PROMO_ON_DND=false

# =============================================================================
# WhatsApp ordering (Meta Cloud API + pg-boss workers)
# =============================================================================

# Master kill switch. "true" starts the pg-boss workers at boot and lets the
# client actually call the Cloud API — and REQUIRES the four Meta values
# below. Anything else: the webhook still records inbound messages durably,
# and outbound replies are recorded as `skipped` instead of sent.
WHATSAPP_ENABLED=false

# From Meta for Developers → your app → WhatsApp → API Setup.
# Use a SYSTEM USER permanent token in production, never a personal one.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The app secret (App Settings → Basic) — verifies X-Hub-Signature-256 on
# every webhook delivery.
WHATSAPP_APP_SECRET=

# Graph API version for Cloud API calls. Versions live ~2 years; bump here
# without a deploy. Default: v25.0 (current as of Feb 2026).
# WHATSAPP_GRAPH_VERSION=v25.0
# You invent this one; paste the same value into the webhook subscription
# form in the Meta dashboard. Meta echoes it in the GET handshake.
WHATSAPP_VERIFY_TOKEN=

# WhatsApp Business Account id — needed by the template-status sync (Phase D).
WHATSAPP_WABA_ID=

# Where copy sends customers who need a human (Inactive account, failed
# order). Shown verbatim in chat messages — and it also powers the menu's
# "Chat with support" row (a wa.me click-to-chat link derived from it).
SUPPORT_PHONE=+2340000000000

# ── Brand strings that appear inside message copy (config/brand.js) ──────────
# These exist so the company name is not written into template literals. In the
# Django system these templates came from it was hardcoded in three places and
# one code path ignored the argument it was passed, so rebranding meant
# grepping for a string rather than changing a setting.
#
# Display name in copy and sign-offs. Defaults to "Soroman".
COMPANY_NAME=
# Longer form for email sign-offs. Defaults to "<COMPANY_NAME> Energy".
COMPANY_LONG_NAME=
# Prefix on expense SMS. Defaults to "<COMPANY_NAME>:". Set to "" to disable.
SMS_BRAND_PREFIX=
# Prefix on the truck/driver SMS, which Django shouted. Defaults to the
# upper-cased company name, e.g. "SOROMAN:".
SMS_BRAND_PREFIX_LOUD=
#
# Comma-separated numbers printed at the foot of customer emails.
# DELIBERATELY has no default: in Django this fell back to three real Soroman
# numbers, so any deployment that forgot the setting quietly told its own
# customers to ring Soroman. Unset here renders nothing at all.
SUPPORT_PHONES=

# Menu link rows (all optional — an unset URL simply hides its row).
# "Visit Soroman page":
SOROMAN_WEBSITE_URL=
# "Join our community" — a WhatsApp Communities invite (chat.whatsapp.com/…):
SOROMAN_COMMUNITY_URL=
# "Download mobile app" — the public URL sent in chat. Point it at this
# backend's GET /app redirect (e.g. https://api.yourdomain.com/app) so each
# customer lands on the right store for their device:
APP_DOWNLOAD_URL=
# Store targets for that /app redirect. Unknown devices (desktop browsers)
# fall back to SOROMAN_WEBSITE_URL, then CLIENT_URL.
APP_STORE_IOS_URL=
APP_STORE_ANDROID_URL=

# Optional: a DIRECT (non-pooled) Neon connection string for pg-boss, so
# queue maintenance bypasses the pooler. Defaults to DATABASE_URL — pg-boss
# polls and never needs LISTEN/NOTIFY, so the pooled string also works.
# PGBOSS_DATABASE_URL=

# Additional customer sign-in methods. Phone+OTP works with none of these set;
# each one below just turns on the corresponding provider.
#
# Google Sign-In — the OAuth client ID from Google Cloud Console. Verification
# uses Google's published JWKS, not this value as a secret — an ID token whose
# audience doesn't match this gets rejected.
GOOGLE_CLIENT_ID=

# Sign in with Apple — the Services ID (not the App ID) from the Apple
# Developer portal. Same JWKS-verification model as Google.
APPLE_CLIENT_ID=

# Passkeys (WebAuthn). RP_ID is the bare domain (no scheme/port) the frontend
# is served from; ORIGIN is the full origin the browser sends. They must match
# exactly what the browser reports or every ceremony fails to verify.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Notifications engine
# ─────────────────────────────────────────────────────────────────────────────
# One engine serves the mobile app, the admin dashboard and the web portal
# across four channels: in-app, push, email and SMS. See docs/NOTIFICATIONS.md.

# Master kill switch. "false" writes nothing and sends nothing — useful for a
# load test or a data migration, never for normal running.
# NOTIFICATIONS_ENABLED=true

# Durability. When true, notify() enqueues a pg-boss job and a worker delivers,
# so an in-flight fan-out survives a deploy or a crash. When false (the
# default) it dispatches in-process — right for dev and tests, which have no
# worker running. Turn this ON in production.
NOTIFY_QUEUE_ENABLED=false

# Where deep links point. ADMIN_URL is the dashboard, PORTAL_URL the customer
# web app; both fall back to CLIENT_URL when unset, which is correct while the
# two are served from one origin.
# ADMIN_URL=
# PORTAL_URL=

# Quiet hours are stored per person, in their own timezone. This is the zone
# assumed for anyone who has not set one.
# NOTIFY_DEFAULT_TZ=Africa/Lagos

# ─── Push (Firebase Cloud Messaging, HTTP v1) ────────────────────────────────
# Covers Android AND iOS — iOS is relayed through FCM's APNs bridge, so there
# is no separate APNs certificate to install or renew.
#
# From the Firebase console: Project settings → Service accounts → Generate new
# private key. The downloaded JSON contains all three values below.
#
# FCM_PRIVATE_KEY is a PEM block. A .env file cannot hold real newlines, so
# paste it with literal \n sequences and wrap it in double quotes:
#   FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvg...\n-----END PRIVATE KEY-----\n"
# A value pasted from a secrets manager with real newlines also works.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Set "false" to keep push off while the rest of the engine runs.
# PUSH_ENABLED=true

# Android notification channels. These ids MUST match the channels the mobile
# app creates at startup — Android silently drops a notification naming a
# channel that does not exist, so a wrong value here is invisible
# non-delivery rather than an error anyone would notice.
#
# LEAVE UNSET unless you know the ids. Unset, channels/push.js sends no
# channelId at all and Expo rings its own default channel — the behaviour
# that has been shipping. The Expo app creates soroman_orders,
# soroman_payments and soroman_general (ensureAndroidChannels in its
# services/pushNotifications.ts); set these only to ids from that list.
#
# Note the two push paths disagree when these are unset: fcm.js falls back to
# the hardcoded soroman_important / soroman_default, which the Expo app does
# NOT create. That only matters for a client minting raw FCM tokens — set
# these if one ever registers.
# PUSH_ANDROID_CHANNEL_HIGH=
# PUSH_ANDROID_CHANNEL_DEFAULT=
# PUSH_WEB_ICON_URL=

# ─── Email ───────────────────────────────────────────────────────────────────
# Uses the RESEND_API_KEY and EMAIL_FROM already configured above.
# EMAIL_ENABLED=true
#
# Staff email is PAUSED by default. Every order and payment emailed all twelve
# staff — ~580 messages a day against a plan that allows 100, so the allowance
# was spent by mid-morning and customers' mail failed behind it. Staff still
# get everything in-app and on push; only the mailbox copy stops, and password
# setup/reset and the daily/Hub reports keep sending regardless.
# Set to true to bring staff email back.
# STAFF_EMAIL_ENABLED=false

# ─── SMS ─────────────────────────────────────────────────────────────────────
# Uses the TERMII_* settings already configured above. Termii bills per 153-
# character part, so engine-sent SMS is capped — 612 is four parts.
# NOTIFY_SMS_MAX_LENGTH=612

# ─── Live stream (SSE) ───────────────────────────────────────────────────────
# The stream is in-process: a browser connected to one instance hears nothing
# from another. Correct for a single-instance deployment; with more than one,
# use sticky sessions or let clients fall back to polling /unread-count.
# NOTIFY_SSE_HEARTBEAT_MS=25000
# NOTIFY_SSE_RETRY_MS=5000
# NOTIFY_SSE_MAX_PER_PRINCIPAL=5
# Browsers cannot set headers on EventSource, so they exchange a Bearer token
# for a single-use ticket. Short by design.
# NOTIFY_STREAM_TICKET_TTL_MS=30000

# ─── Retention ───────────────────────────────────────────────────────────────
# Swept by the maintenance cron (worker) or POST /api/notifications/maintenance/run.
# Only READ or ARCHIVED notifications are ever purged — something never seen is
# never swept out from under its recipient.
# NOTIFY_RETENTION_DAYS=180
# NOTIFY_DELIVERY_RETENTION_DAYS=60
# NOTIFY_DEAD_TOKEN_RETENTION_DAYS=60
# NOTIFY_MAINTENANCE_CRON=30 3 * * *
